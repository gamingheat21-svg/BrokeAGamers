# Required in production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# Hosting providers usually set PORT automatically.
PORT=5000

# Optional. Use a comma-separated list if your frontend is hosted separately.
# If this app is served by the Express server, you can leave this blank.
CLIENT_ORIGIN=http://localhost:5173
